#!/usr/bin/env bash
# census-L7-20-wait (census-L7-20-wait.service, root; 2026-10-10 ~00:20 UTC): start census-L7-20 (the 55 L
# projects of batches 7-20, 6 workers) only when the big EC2 has room. The L projects may end as late
# as 2026-10-20 20:00 UTC (user, ~20:15 UTC 2026-10-09), so the rule is safe rather than early. Every
# 60 s it starts census-L7-20.service when ALL of these hold:
#   (1) census-batch6L has started: its waiter is no longer active and its census is active or has
#       a ledger (/b6L/ctp/ledger.jsonl);
#   (2) at most MAXRUN (default 10) other projects run on the instance (batch2, batch3L, batch4p1-3,
#       batch5L, batch6L; census-steps --counts of each active census), so with 6 more it runs <= 16;
#   (3) MemAvailable >= MINMEM_GB (default 120 GiB);
#   (4) /data has >= MINDISK_GB (default 2500) GiB free;
#   (5) the identity gate passed for the commit /bL7/cregit-ec2 is at: the last line of
#       /etc/cregit-census/L7-20.gate is "CHECK OK <time> cregit <that commit> ..." (census-L7-20-cregit);
#   (6) the inputs are there: /home/ec2-user/L7-20-input/SHA256SUMS checks (s3://BUCKET/L7-20/input/ is
#       copied as ec2-user while it is missing).
# A STOP file in /bL7/ctp holds the start. Status: /run/census-L7-20-wait.status.
# --decide-only: print the decision once and exit (0 = would start, 1 = would wait); starts nothing.
# Test overrides: COUNTS_<name> ("RUNNING NOT_STARTED"), ACTIVE_<name> per census name (batch2 batch3L
# batch4p1 batch4p2 batch4p3 batch5L batch6L), B6L_STARTED (1/0), MEMAVAIL_GB, DATAFREE_GB, GATE_OK (1/0),
# INPUT_OK (1/0).
set -uo pipefail
MAXRUN=${MAXRUN:-10}; MINMEM=${MINMEM_GB:-120}; MINDISK=${MINDISK_GB:-2500}
ST=/run/census-L7-20-wait.status; IN=/home/ec2-user/L7-20-input
CENS="batch2|census-batch2.service|/home/ec2-user/ctp|/home/ec2-user/batch2-input/manifest.batch2.tsv
batch3L|census-batch3L.service|/home/ec2-user/ctp-b3L|/home/ec2-user/batch3L-input/manifest.batch3L.tsv
batch4p1|census-batch4p1.service|/b4p1/ctp|/home/ec2-user/batch4-input/manifest.batch4p1.tsv
batch4p2|census-batch4p2.service|/b4p2/ctp|/home/ec2-user/batch4-input/manifest.batch4p2.tsv
batch4p3|census-batch4p3.service|/b4p3/ctp|/home/ec2-user/batch4-input/manifest.batch4p3.tsv
batch5L|census-batch5L.service|/b5L/ctp|/home/ec2-user/batch5-input/manifest.batch5L.tsv
batch6L|census-batch6L.service|/b6L/ctp|/home/ec2-user/batch6-input/manifest.batch6L.tsv"
inputs() {  # 0 when the inputs check; copies them while they are missing
  [ -n "${INPUT_OK:-}" ] && { [ "$INPUT_OK" = 1 ]; return; }
  (cd $IN 2>/dev/null && sha256sum --quiet -c SHA256SUMS >/dev/null 2>&1) && return 0
  sudo -u ec2-user bash -c "mkdir -p $IN; AWS_PAGER= aws s3 cp s3://${RUNNER_BUCKET}/L7-20/input/ $IN/ --recursive --only-show-errors" >/dev/null 2>&1
  (cd $IN 2>/dev/null && sha256sum --quiet -c SHA256SUMS >/dev/null 2>&1)
}
decide() {  # sets msg; returns 0 = start
  local run=0 bad="" n u c m s cv av r p desc=""
  while IFS='|' read -r n u c m; do
    av="ACTIVE_$n"; s=${!av-$(systemctl is-active "$u")}
    case $s in active|activating|deactivating) ;; *) desc="$desc $n=$s"; continue ;; esac
    cv="COUNTS_$n"; read -r r p < <(echo "${!cv-$(/usr/local/bin/census-steps --counts "$c" "$m" 2>/dev/null || echo '? ?')}")
    case "$r$p" in *[!0-9]*|'') bad="$bad $n"; desc="$desc $n=?"; continue ;; esac
    run=$((run + r)); desc="$desc $n=${r}r/${p}q"
  done <<<"$CENS"
  local mem=${MEMAVAIL_GB:-$(awk '/MemAvailable/{printf "%d", $2/1048576}' /proc/meminfo)}
  local disk=${DATAFREE_GB:-$(df -BG --output=avail /data | tail -1 | tr -dc 0-9)}
  local b6=${B6L_STARTED:-}
  if [ -z "$b6" ]; then b6=0
    case $(systemctl is-active census-batch6L-wait.service) in active|activating) ;; *)
      { case $(systemctl is-active census-batch6L.service) in active|activating) true ;; *) false ;; esac || [ -e /b6L/ctp/ledger.jsonl ]; } && b6=1 ;; esac
  fi
  msg="$(date -u +%FT%TZ) batch6L started=$b6, other projects running $run (max $MAXRUN), MemAvailable ${mem}G (min $MINMEM), /data free ${disk}G (min $MINDISK);$desc"
  [ -z "$bad" ] || { msg="$msg; counts unreadable for:$bad: waiting"; return 1; }
  [ -e /bL7/ctp/STOP ] && { msg="$msg; STOP exists in /bL7/ctp: holding"; return 1; }
  [ "$b6" = 1 ] || { msg="$msg; batch6L has not started: waiting"; return 1; }
  [ "$run" -le "$MAXRUN" ] || { msg="$msg; too many running: waiting"; return 1; }
  [ "$mem" -ge "$MINMEM" ] || { msg="$msg; memory low: waiting"; return 1; }
  [ "$disk" -ge "$MINDISK" ] || { msg="$msg; /data low: waiting"; return 1; }
  local gok=${GATE_OK:-} gc head
  if [ -z "$gok" ]; then
    gc=$(tail -1 /etc/cregit-census/L7-20.gate 2>/dev/null | sed -n 's/^CHECK OK [^ ]* cregit \([0-9a-f]\{40\}\).*/\1/p')
    head=$(sudo -u ec2-user git -C /bL7/cregit-ec2 rev-parse HEAD 2>/dev/null); gok=0; [ -n "$gc" ] && [ "$gc" = "$head" ] && gok=1
  fi
  [ "$gok" = 1 ] || { msg="$msg; no passed identity gate for the cregit commit of /bL7/cregit-ec2 (census-L7-20-cregit): waiting"; return 1; }
  inputs || { msg="$msg; inputs s3://BUCKET/L7-20/input/ missing or not checked: waiting"; return 1; }
  msg="$msg; start"; return 0
}
if [ "${1:-}" = --decide-only ]; then decide; rc=$?; echo "decide-only: $msg"; exit $rc; fi
while :; do
  if decide; then
    echo "$msg: starting census-L7-20.service" | tee "$ST"
    systemctl start --no-block census-L7-20.service
    exit 0
  fi
  echo "$msg" > "$ST"
  sleep 60
done
