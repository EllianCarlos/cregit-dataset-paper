# runner.env.example: the values of the tokens ${RUNNER_NAME} in the runner copies.
# Copy this file to runner.env and fill in your values. runner.env stays local (.gitignore).
# render.py reads runner.env as text: NAME=VALUE or NAME='VALUE'. It does not run it.
# A1..A6 are the spot machines of half a, B1..B5 of half b, in launch order
# (ec2-batch3/README.md and the README.md files of the later batches).

# the S3 bucket of the dataset build (inputs, logs, results)
RUNNER_BUCKET='<bucket>'
# the 12-digit AWS account id
RUNNER_AWS_ACCOUNT='<aws-account>'
# the AWS CLI profile of the local machine
RUNNER_AWS_PROFILE='<aws-profile>'
# the home directory by its /local path
RUNNER_HOME_LOCAL='<home-local>'
# the home directory
RUNNER_HOME='<home>'
# the text that the scripts use for the projects directory, for example $HOME/src
RUNNER_PROJECTS='<projects>'
# the same directory, in the form with ~
RUNNER_PROJECTS_TILDE='<projects-tilde>'
# the directory name of the study repository
RUNNER_STUDY_REPO='<study-repo>'
# the user name (the Owner tag of the machines)
RUNNER_USER='<user>'
# the AWS region
RUNNER_AWS_REGION='<aws-region>'
# the big on-demand machine (the L queues of batches 2 to 6, L7-20, L7-20b, L22, L23, L1r)
RUNNER_EC2_BIG='<ec2-big>'
# a spot machine
RUNNER_EC2_SPOT_A1='<ec2-spot-a1>'
# a spot machine
RUNNER_EC2_SPOT_B1='<ec2-spot-b1>'
# a spot machine
RUNNER_EC2_SPOT_A2='<ec2-spot-a2>'
# a spot machine
RUNNER_EC2_SPOT_B2='<ec2-spot-b2>'
# a spot machine
RUNNER_EC2_SPOT_B3='<ec2-spot-b3>'
# a spot machine
RUNNER_EC2_SPOT_A3='<ec2-spot-a3>'
# a spot machine
RUNNER_EC2_SPOT_A4='<ec2-spot-a4>'
# a spot machine
RUNNER_EC2_SPOT_B4='<ec2-spot-b4>'
# a spot machine
RUNNER_EC2_SPOT_A5='<ec2-spot-a5>'
# a spot machine
RUNNER_EC2_SPOT_A6='<ec2-spot-a6>'
# a spot machine
RUNNER_EC2_SPOT_B5='<ec2-spot-b5>'
# the AMI of the spot machines (made in batch 3)
RUNNER_AMI_SPOT='<ami-spot>'
# the base AMI (the fallback of launch_spot.sh)
RUNNER_AMI_BASE='<ami-base>'
# the security group of the spot machines
RUNNER_SECURITY_GROUP='<security-group>'
# the launch template of the spot machines
RUNNER_LAUNCH_TEMPLATE='<launch-template>'
# a subnet of the spot fleet
RUNNER_SUBNET_1='<subnet-1>'
# a subnet of the spot fleet
RUNNER_SUBNET_2='<subnet-2>'
# a subnet of the spot fleet
RUNNER_SUBNET_3='<subnet-3>'
# a subnet of the spot fleet
RUNNER_SUBNET_4='<subnet-4>'

# Tokens of the later run kits (dataset-x1k/, dataset-v0-org/, dataset-pathfix/, dataset-v1/),
# added on 2026-10-25. The kit scripts refuse to run on the machines that they name.
# the subnet of the spot fleets in availability zone a of the region (the same for b, c, d)
RUNNER_SUBNET_AZ_A='<subnet-az-a>'
RUNNER_SUBNET_AZ_B='<subnet-az-b>'
RUNNER_SUBNET_AZ_C='<subnet-az-c>'
RUNNER_SUBNET_AZ_D='<subnet-az-d>'
# the first machine of the 1,000-4,999 layer (reclaimed on 2026-10-18)
RUNNER_EC2_X1K_A='<ec2-x1k-a>'
# the two machines of the relaunch (machine B, slots 1 and 2)
RUNNER_EC2_X1K_B1='<ec2-x1k-b1>'
RUNNER_EC2_X1K_B2='<ec2-x1k-b2>'
# the machine A of the 11 long rows, in launch order (dataset-x1k/instances.txt)
RUNNER_EC2_X1K_LONG_A1='<ec2-x1k-long-a1>'
RUNNER_EC2_X1K_LONG_A2='<ec2-x1k-long-a2>'
RUNNER_EC2_X1K_LONG_A3='<ec2-x1k-long-a3>'
RUNNER_EC2_X1K_LONG_A4='<ec2-x1k-long-a4>'
# the extra machines of the aws-sdk-rust blame (part N, relaunch rK)
RUNNER_EC2_RUST_SPLIT_1='<ec2-rust-split-1>'
RUNNER_EC2_RUST_SPLIT_1_R1='<ec2-rust-split-1-r1>'
RUNNER_EC2_RUST_SPLIT_2='<ec2-rust-split-2>'
RUNNER_EC2_RUST_SPLIT_2_R1='<ec2-rust-split-2-r1>'
RUNNER_EC2_RUST_SPLIT_2_R2='<ec2-rust-split-2-r2>'
RUNNER_EC2_RUST_SPLIT_3='<ec2-rust-split-3>'
RUNNER_EC2_RUST_SPLIT_3_R1='<ec2-rust-split-3-r1>'
RUNNER_EC2_RUST_SPLIT_4='<ec2-rust-split-4>'
RUNNER_EC2_RUST_SPLIT_4_R1='<ec2-rust-split-4-r1>'
RUNNER_EC2_RUST_SPLIT_5='<ec2-rust-split-5>'
RUNNER_EC2_RUST_SPLIT_5_R1='<ec2-rust-split-5-r1>'
RUNNER_EC2_RUST_SPLIT_5_R2='<ec2-rust-split-5-r2>'
# the extra machines of the aws-sdk-java blame
RUNNER_EC2_JAVA_SPLIT_1='<ec2-java-split-1>'
RUNNER_EC2_JAVA_SPLIT_2='<ec2-java-split-2>'
# the merge machines of the 1,000-4,999 layer (pass 1 and pass 2)
RUNNER_EC2_X1K_RAW_1='<ec2-x1k-raw-1>'
RUNNER_EC2_X1K_RAW_2='<ec2-x1k-raw-2>'
# the links machine of both layers
RUNNER_EC2_X1K_LINKS_1='<ec2-x1k-links-1>'
# the machine of the organisation columns of version 1
RUNNER_EC2_V0_ORG_1='<ec2-v0-org-1>'
# the machine of the path-fix rerun
RUNNER_EC2_PATHFIX_B1='<ec2-pathfix-b1>'
