+def test_no_firm_skips_the_firm_phase_and_gates_the_cregit_columns(sandbox, runner, jq):
+    """--no-firm (a test run up to the runner's Parquet): no firm phase, and validate
+    gates cregit's 67 columns, so the project still validates and is skipped later."""
+    ctp._OPTS.update(no_firm=True)
+    assert ctp.run_project(jq) == "done"
+    assert [c.phase for c in runner.calls] == ["pipeline", "validate"]
+    assert runner.argv("validate") == [
+        "python3", str(sandbox.root / "validate.py"),
+        str(sandbox.out / "jq" / "jq-dataset.parquet"),
+        str(sandbox.out / "jq" / "jq.validated"), "--cregit-only",
+    ]
+
+
+def test_run_options_carry_no_firm_off_by_default(sandbox, runner_script):
+    runner_script()
+    assert ctp.run_options(run_args())["no_firm"] is False
+    assert ctp.run_options(run_args(no_firm=True))["no_firm"] is True
+
+
+@pytest.mark.parametrize("over", [
+    pytest.param(dict(join=True), id="join"),
+    pytest.param(dict(anonymize="/some/anon.py"), id="anonymize"),
+])
+def test_no_firm_is_refused_with_the_70_column_publish_steps(sandbox, runner_script, over):
+    runner_script()
+    with pytest.raises(SystemExit, match="--no-firm"):
+        ctp.run_options(run_args(no_firm=True, **over))
+
+
+def test_no_firm_is_a_census_option_off_by_default(monkeypatch):
+    seen = []
+    monkeypatch.setattr(ctp, "cmd_census", lambda args: seen.append(args.no_firm) or 0)
+    for extra in ([], ["--no-firm"]):
+        monkeypatch.setattr(ctp.sys, "argv", ["ctp.py", "census", *extra])
+        ctp.main()
+    assert seen == [False, True]
+
